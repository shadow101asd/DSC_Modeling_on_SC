# CompilerName=clang
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/maca64
matlabdir = /Applications/MATLAB_R2024a.app
startdir = /Users/jpenot/Documents/MATLAB/SC/DSC_Modeling_on_SC/Run

# Toolchain information
cc = /usr/bin/xcrun -sdk macosx14.4 clang
cxx = /usr/bin/xcrun -sdk macosx14.4 clang++
linker = /usr/bin/xcrun -sdk macosx14.4 clang
linkerxx = /usr/bin/xcrun -sdk macosx14.4 clang++

cflags =  -fno-common -arch arm64 -mmacosx-version-min=11.0 -fexceptions -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk -fwrapv -ffp-contract=off  -DMATLAB_MEX_FILE -O2 -DNDEBUG -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=lambert_mex -c 

cxxflags =  -fno-common -arch arm64 -mmacosx-version-min=11.0 -fexceptions -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk -fwrapv -ffp-contract=off  -fobjc-arc -std=c++14 -stdlib=libc++ -DMATLAB_MEX_FILE -O2 -DNDEBUG -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=lambert_mex -c 

ldflags =  -Wl,-twolevel_namespace  -arch arm64 -mmacosx-version-min=11.0 -Wl,-syslibroot,/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk -bundle   -L"$matlabdir/bin/maca64" -lmx -lmex -lmat -lc++  -Wl,-rpath,@loader_path -o lambert_mex.mexmaca64 -lemlrt -lcovrt -lut -lmwmathutil  -Wl,-exported_symbols_list,lambert_mex.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldflags

# Build
build $builddir/lambert_data.o : cc $root/lambert_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/lambert_initialize.o : cc $root/lambert_initialize.c
build $builddir/lambert_terminate.o : cc $root/lambert_terminate.c
build $builddir/lambert.o : cc $root/lambert.c
build $builddir/mod.o : cc $root/mod.c
build $builddir/power.o : cc $root/power.c
build $builddir/_coder_lambert_api.o : cc $root/interface/_coder_lambert_api.c
build $builddir/_coder_lambert_mex.o : cc $root/interface/_coder_lambert_mex.c
build $builddir/sqrt.o : cc $root/sqrt.c
build $builddir/asin.o : cc $root/asin.c
build $builddir/acos.o : cc $root/acos.c
build $builddir/acosh.o : cc $root/acosh.c
build $builddir/asinh.o : cc $root/asinh.c
build $builddir/_coder_lambert_info.o : cc $root/interface/_coder_lambert_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/lambert_mex.mexmaca64 : link $builddir/lambert_data.o $builddir/rt_nonfinite.o $builddir/lambert_initialize.o $builddir/lambert_terminate.o $builddir/lambert.o $builddir/mod.o $builddir/power.o $builddir/_coder_lambert_api.o $builddir/_coder_lambert_mex.o $builddir/sqrt.o $builddir/asin.o $builddir/acos.o $builddir/acosh.o $builddir/asinh.o $builddir/_coder_lambert_info.o $builddir/c_mexapi_version.o 
