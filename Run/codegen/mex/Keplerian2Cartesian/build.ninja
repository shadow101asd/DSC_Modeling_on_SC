# CompilerName=clang
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/maca64
matlabdir = /Applications/MATLAB_R2024a.app
startdir = /Users/jpenot/Documents/MATLAB/SC/DSC_Modeling_on_SC/Run

# Toolchain information
cc = /usr/bin/xcrun -sdk macosx14.4 clang
cxx = /usr/bin/xcrun -sdk macosx14.4 clang++
linker = /usr/bin/xcrun -sdk macosx14.4 clang
linkerxx = /usr/bin/xcrun -sdk macosx14.4 clang++

cflags =  -fno-common -arch arm64 -mmacosx-version-min=11.0 -fexceptions -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk -fwrapv -ffp-contract=off  -DMATLAB_MEX_FILE -O2 -DNDEBUG -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=Keplerian2Cartesian_mex -c 

cxxflags =  -fno-common -arch arm64 -mmacosx-version-min=11.0 -fexceptions -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk -fwrapv -ffp-contract=off  -fobjc-arc -std=c++14 -stdlib=libc++ -DMATLAB_MEX_FILE -O2 -DNDEBUG -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=Keplerian2Cartesian_mex -c 

ldflags =  -Wl,-twolevel_namespace  -arch arm64 -mmacosx-version-min=11.0 -Wl,-syslibroot,/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk -bundle   -L"$matlabdir/bin/maca64" -lmx -lmex -lmat -lc++  -Wl,-rpath,@loader_path -o Keplerian2Cartesian_mex.mexmaca64 -L"$matlabdir/bin/maca64" -lmwblas -lemlrt -lcovrt -lut -lmwmathutil  -Wl,-exported_symbols_list,Keplerian2Cartesian_mex.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldflags

# Build
build $builddir/Keplerian2Cartesian_data.o : cc $root/Keplerian2Cartesian_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/Keplerian2Cartesian_initialize.o : cc $root/Keplerian2Cartesian_initialize.c
build $builddir/Keplerian2Cartesian_terminate.o : cc $root/Keplerian2Cartesian_terminate.c
build $builddir/Keplerian2Cartesian.o : cc $root/Keplerian2Cartesian.c
build $builddir/norm.o : cc $root/norm.c
build $builddir/assertCompatibleDims.o : cc $root/assertCompatibleDims.c
build $builddir/_coder_Keplerian2Cartesian_api.o : cc $root/interface/_coder_Keplerian2Cartesian_api.c
build $builddir/_coder_Keplerian2Cartesian_mex.o : cc $root/interface/_coder_Keplerian2Cartesian_mex.c
build $builddir/eml_int_forloop_overflow_check.o : cc $root/eml_int_forloop_overflow_check.c
build $builddir/cos.o : cc $root/cos.c
build $builddir/sin.o : cc $root/sin.c
build $builddir/sqrt.o : cc $root/sqrt.c
build $builddir/div.o : cc $root/div.c
build $builddir/Keplerian2Cartesian_emxutil.o : cc $root/Keplerian2Cartesian_emxutil.c
build $builddir/_coder_Keplerian2Cartesian_info.o : cc $root/interface/_coder_Keplerian2Cartesian_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/Keplerian2Cartesian_mex.mexmaca64 : link $builddir/Keplerian2Cartesian_data.o $builddir/rt_nonfinite.o $builddir/Keplerian2Cartesian_initialize.o $builddir/Keplerian2Cartesian_terminate.o $builddir/Keplerian2Cartesian.o $builddir/norm.o $builddir/assertCompatibleDims.o $builddir/_coder_Keplerian2Cartesian_api.o $builddir/_coder_Keplerian2Cartesian_mex.o $builddir/eml_int_forloop_overflow_check.o $builddir/cos.o $builddir/sin.o $builddir/sqrt.o $builddir/div.o $builddir/Keplerian2Cartesian_emxutil.o $builddir/_coder_Keplerian2Cartesian_info.o $builddir/c_mexapi_version.o 
