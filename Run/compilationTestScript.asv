%% Compiling Keplerian2Cartesian

a_type  = coder.typeof(0, [1 Inf]);    % 1×n double, n variable
e_type  = coder.typeof(0, [1 Inf]);    
i_type  = coder.typeof(0, [1 Inf]);
Om_type = coder.typeof(0, [1 Inf]);
w_type  = coder.typeof(0, [1 Inf]);
f0_type = coder.typeof(0, [1 Inf]);
mu_type = 0;                           % scalar double

codegen Keplerian2Cartesian -args {a_type, e_type, i_type, Om_type, w_type, f0_type, mu_type}


%% Compiling updateTrueAnomaly

example_input = {
    7000, ...     % a
    0.01, ...     % e
    0.1, ...      % i
    1.0, ...      % Om
    1.0, ...      % w
    0.5, ...      % f0
    398600.23, ...   % mu
    60.0            % dt
};

codegen updateTrueAnomaly -args example_input

%% createAdjacencyMatrix_euclid_distance_block_dense

% Define variable-size inputs with upper bounds
Xs_type = coder.typeof(0, [3, 1000, 500], [false, true, true]);   % [3 × nT × N], variable in 2nd and 3rd dim
cutoff_type = coder.typeof(0, [1, 1000], [false, true]);          % [1 × nT], variable length
blockSize_type = 100;                                              % Scalar double

% Run codegen
codegen createAdjacencyMatrix_euclid_distance_block_dense -args {Xs_type, cutoff_type, blockSize_type}


%% propagateFromKeplerians