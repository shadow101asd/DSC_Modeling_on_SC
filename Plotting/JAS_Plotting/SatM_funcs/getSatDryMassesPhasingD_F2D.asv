function [m_dry_persat, TOD, exitflag] = getSatDryMassesPhasingD_F2D(aFLO,eFLO,NM,Nw,mu,NL,Npl,f, ...
    Shuttle_Isp,Sat_Isp,Shuttle_wetMass,Shuttle_dryMass,maxShuttlePayload, SDVs, SDPs, STOFs)

% Units
% Outputs:
% m_dry_persat - [kg]
% TOD          - [Earth years (365.25 days)]
% exitflag     - Boolean

% Constants
AU = 1.496e8; % 1 AU in km
g0 = 9.81; % m/s^2

% Shuttle Hohmann transfer to Deployment Orbit
% Cheaper Approach: Integrate first Leg of Hohmann into Earth Escape Burn

% Find desired v_inf.
[~, Shuttle_TOF, DV1, DV2] = computeHohmannTransferCirc2Ell(AU, aFLO, eFLO, mu); % outputs in km/s
vinf = abs(DV1); % Is this correct independent of the direction?

muE = 3.986004e5; % km3/s2
RE = 6378; % km
a = 200; % LEO orbit altitude (km)
v_escape = sqrt(2*muE/(RE + a)); % Escape velocity at LEO (a = 200 km) in km/s

V = sqrt(vinf^2 + v_escape^2);

v_LEO = sqrt(muE/(RE+a));

DV_LEO2EE = V-v_LEO; % km/s
DV_LEO2EE = DV_LEO2EE*10^3; % convert to m/s

DV2 = abs(DV2) * 10^3; % Make sure it's positive and in m/s

m_SATS = computeMaxPayloadMass(maxShuttlePayload, DV_LEO2EE+DV2, Shuttle_dryMass, Shuttle_wetMass-Shuttle_dryMass, Shuttle_Isp, g0);    

if isnan(m_SATS)
    m_dry_persat = NaN;
    TOD = NaN;
    exitflag = 0; % Infeasible launch and insertion (undefined/negative payload mass)
    return
end
% Otherwise, the launch is feasible, and we proceed.

if nargin <= 13
    
    % Compute satellite insertion DV - phasing deployment
    [Sat_DVs, DPs_opt] = compute_SIdeployment_SatDVs_2DF(Nw,NM,aFLO,eFLO,NL,Npl,f);
    Sat_DVs = Sat_DVs * 1e3; % convert km/s to m/s
    
    % Compute final dry mass per satellite
    m_dry_persat = m_SATS / sum(exp(Sat_DVs/(Sat_Isp*g0)));    
    
    exitflag = 1;
    
    %  Extract deployment times 
    
    TODs = NaN(1,Npl);
    for s = 1:Npl
        [~, ~, ~, ~, details] = computeOptimalPhasingDV_2DF_extended(Nw, -NM, eFLO, DPs_opt(s));
        TODs(s) = details.t2;
    end
    
    % add up deployment times
    year = 365.25*24*3600; % one year in seconds
    TFC = 2*pi*sqrt(aFLO^3/mu); % flower constellation orbital period
    
    TOD_seconds = Shuttle_TOF + f*TFC + max(TODs); % Total deployment time, seconds
    TOD = TOD_seconds/year; % convert to Earth years

else
    
end

end